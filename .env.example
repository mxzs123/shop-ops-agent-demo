# Claude API key. Can also be set per browser in the settings dialog.
ANTHROPIC_API_KEY=
# Optional: override the model (default: claude-opus-5-5).
ANTHROPIC_MODEL=

ADMIN_AGENT_HOST=127.0.0.1
ADMIN_AGENT_PORT=18083
ADMIN_AGENT_ALLOWED_ORIGINS=http://127.0.0.1:18083,http://localhost:18083
ADMIN_AGENT_AUDIT_LOG=logs/audit.jsonl

# "fixture" (default) runs entirely on the fictional catalog in fixtures/.
# "admin" talks to a real store admin backend and needs the settings below.
ADMIN_AGENT_BACKEND=fixture
ADMIN_AGENT_FIXTURE_PATH=fixtures/goods.example.json

# Only for ADMIN_AGENT_BACKEND=admin.
ADMIN_AGENT_ADMIN_BASE_URL=http://127.0.0.1:18080/
ADMIN_AGENT_ADMIN_PUBLIC_BASE_URL=http://127.0.0.1:18080/
ADMIN_AGENT_WEBAPI_BASE_URL=http://127.0.0.1:18081/
ADMIN_AGENT_ADMIN_USERNAME=
ADMIN_AGENT_ADMIN_PASSWORD=
ADMIN_AGENT_ADMIN_AUTHORIZATION=
# Writes to a real backend stay blocked unless this is true.
ADMIN_AGENT_ALLOW_WRITES=false
